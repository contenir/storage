{
    "name": "contenir/storage",
    "description": "Framework-agnostic asset storage for Contenir CMS — local, S3-compatible, and Cloudflare Images adapters with a shared variant pipeline.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "league/flysystem": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-memory": "^3.0",
        "gumlet/php-image-resize": "^2.0",
        "cloudflare/sdk": "^1.1",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "gumlet/php-image-resize": "Required by ImageResizer for local variant generation.",
        "league/flysystem-aws-s3-v3": "Required by the S3 adapter.",
        "cloudflare/sdk": "Required by the CloudflareImages adapter."
    },
    "autoload": {
        "psr-4": { "Contenir\\Storage\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Contenir\\Storage\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}